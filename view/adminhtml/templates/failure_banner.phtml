/** @var \Mageplaza\Smtp\Block\Adminhtml\FailureBanner $block */
?>
<?php if ($block->isFailing()): ?>
<div class="mageplaza-smtp-alert-banner" role="alert">
    <span class="mageplaza-smtp-alert-icon" aria-hidden="true">&#9888;</span>
    <span class="mageplaza-smtp-alert-text">
        <?= $block->escapeHtml($block->getNoticeText()) ?>
        <a class="mageplaza-smtp-alert-link" href="<?= $block->escapeUrl($block->getConfigUrl()) ?>">
            <?= $block->escapeHtml(__('Open SMTP configuration')) ?>
        </a>
    </span>
</div>
<?php endif; ?>
